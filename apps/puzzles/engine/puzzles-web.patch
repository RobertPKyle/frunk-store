diff --git a/emcc.c b/emcc.c
index ae90f3c..f7a23ab 100644
--- a/emcc.c
+++ b/emcc.c
@@ -44,6 +44,8 @@
 
 #include "puzzles.h"
 
+#include <emscripten.h>
+
 /*
  * Extern references to Javascript functions provided in emcclib.js.
  */
@@ -309,6 +311,56 @@ static void post_move(void)
     js_enable_undo_redo(midend_can_undo(me), midend_can_redo(me));
     js_update_key_labels(midend_current_key_label(me, CURSOR_SELECT2),
                          midend_current_key_label(me, CURSOR_SELECT));
+    /* frunk.store: tell the page, which saves the game and updates its keys */
+    EM_ASM({ if (typeof web_moved === 'function') web_moved(); });
+}
+
+/*
+ * frunk.store additions for the page's own controls.
+ */
+
+/* The keys the puzzle wants on screen (for its current size), as
+ * "label\x1fbutton\x1e..." for the page's key pad. Free with
+ * free_save_file. */
+char *web_keys(void)
+{
+    int n, i;
+    size_t len = 1;
+    char *out, *p;
+    key_label *keys = midend_request_keys(me, &n);
+    for (i = 0; i < n; i++)
+        len += strlen(keys[i].label) + 16;
+    out = p = snewn(len, char);
+    *p = '\0';
+    for (i = 0; i < n; i++)
+        p += sprintf(p, "%s\x1f%d\x1e", keys[i].label, keys[i].button);
+    free_keys(keys, n);
+    return out;
+}
+
+/* A key from the page's key pad */
+void web_key(int button)
+{
+    midend_process_key(me, 0, 0, button);
+    post_move();
+}
+
+/* Cursor keys, for controllers: 0 up, 1 down, 2 left, 3 right,
+ * 4 select, 5 select 2 */
+void web_cursor(int which)
+{
+    static const int buttons[] = { CURSOR_UP, CURSOR_DOWN, CURSOR_LEFT,
+                                   CURSOR_RIGHT, CURSOR_SELECT,
+                                   CURSOR_SELECT2 };
+    if (which < 0 || which > 5) return;
+    midend_process_key(me, 0, 0, buttons[which]);
+    post_move();
+}
+
+/* +1 solved, -1 lost (Mines), 0 still going */
+int web_status(void)
+{
+    return midend_status(me);
 }
 
