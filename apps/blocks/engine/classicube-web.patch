+#ifdef CC_BUILD_WEB
+EMSCRIPTEN_KEEPALIVE int web_save(void) {
+	cc_string path; char pathBuffer[FILENAME_SIZE];
+	char name[STRING_SIZE + 1];
+	struct GZipState* state;
+	cc_result res;
+	int len;
+	/* World.Loaded is false while a new world is being made; a world that */
+	/* failed to load has no blocks, and mustn't replace the file */
+	if (!Server.IsSinglePlayer || !World.Loaded || !World.Blocks) return -1;
+
+	if (!World.Name.length) {
+		len = EM_ASM_INT({ return stringToUTF8(Module['worldName'] ? Module['worldName']() : 'World', $0, $1); }, name, STRING_SIZE);
+		String_AppendAll(&World.Name, name, len);
+	}
+	String_InitArray(path, pathBuffer);
+	String_Format1(&path, "maps/%s.cw", &World.Name);
+
+	state = (struct GZipState*)Mem_TryAlloc(1, sizeof(struct GZipState));
+	if (!state) return ERR_OUT_OF_MEMORY;
+	res = DoSaveMap(&path, state);
+	Mem_Free(state);
+	if (res) return res;
+
+	World.LastSave = Game.Time;
+	Mem_Copy(name, World.Name.buffer, World.Name.length);
+	name[World.Name.length] = '\0';
+	EM_ASM({ if (Module['worldSaved']) Module['worldSaved'](UTF8ToString($0)); }, name);
+	return 0;
+}
+#endif
