diff --git a/source/build/src/webhost.cpp b/source/build/src/webhost.cpp
new file mode 100644
index 0000000..ed8b3df
--- /dev/null
+++ b/source/build/src/webhost.cpp
@@ -0,0 +1,137 @@
+// [frunk] The browser side of the engine, for frunk.store's Duke Nukem 3D
+// page (apps/duke3d in github.com/RobertPKyle/frunk-store).
+//
+// The game's loops run as they do natively, inside main(); with JSPI, main
+// waits for the page between frames (webWaitFrame, one per screen refresh)
+// and, in loops that don't draw, every so often (webYield), so the page
+// stays responsive. Functions the page calls (web_*) must never wait: they
+// run while main is waiting.
+
+#ifdef __EMSCRIPTEN__
+
+#include "compat.h"
+#include "baselayer.h"
+#include "control.h"
+#include "sdl_inc.h"
+
+#include <emscripten.h>
+
+// Resolved by the page on its next animation frame
+EM_ASYNC_JS(void, webWaitFrameJS, (void), {
+    await Module.webFrame();
+});
+
+EM_ASYNC_JS(void, webYieldJS, (void), {
+    await new Promise(resolve => setTimeout(resolve, 0));
+});
+
+EM_JS(void, webExitJS, (int status), {
+    if (Module.onQuit) Module.onQuit(status);
+});
+
+EM_ASYNC_JS(void, webHaltJS, (void), {
+    await new Promise(() => {});
+});
+
+EM_JS(void, webMessageJS, (char const *title, char const *text), {
+    if (Module.onMessage) Module.onMessage(UTF8ToString(title), UTF8ToString(text));
+});
+
+// Set while the page is calling in, so nothing tries to wait
+int webCalledIn;
+static double webLastYield;
+static int webFrameCount;
+
+void webWaitFrame(void)
+{
+    webFrameCount++;
+    if (webCalledIn) return;
+    webWaitFrameJS();
+    webLastYield = emscripten_get_now();
+}
+
+void webYield(void)
+{
+    if (webCalledIn) return;
+    double const now = emscripten_get_now();
+    if (now - webLastYield < 50) return;
+    webYieldJS();
+    webLastYield = emscripten_get_now();
+}
+
+extern "C" void webExit(int status)
+{
+    webExitJS(status);
+    if (!webCalledIn)
+        webHaltJS();
+    emscripten_force_exit(status);
+    for (;;) {}
+}
+
+void webMessage(char const *title, char const *text)
+{
+    webMessageJS(title, text);
+}
+
+// ---------- input from the page ----------
+
+// The page's buttons, as game functions, and its sticks and finger look.
+// Axes are -32767..32767; look is in mouse units. A button the game has
+// dealt with (CONTROL_ClearButton, as for the map, which toggles) stays
+// off until the page lets it go, as a key would.
+static uint64_t webButtons, webCleared;
+static int32_t webAxes[4];   // forward, sideways, turn, look up/down
+static int32_t webLookX, webLookY;
+
+void webClearButton(int button)
+{
+    webCleared |= button < 0 ? ~(uint64_t)0 : (uint64_t)1 << button;
+}
+
+void webControlInput(ControlInfo *info)
+{
+    CONTROL_ButtonState |= webButtons & ~webCleared;
+    info->dz -= webAxes[0];
+    info->dx += webAxes[1];
+    info->dyaw += webAxes[2];
+    info->dpitch += webAxes[3];
+    info->mousex += webLookX;
+    info->mousey += webLookY;
+    webLookX = webLookY = 0;
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int web_frames(void) { return webFrameCount; }
+
+// One state for every frame: game functions held (two 32-bit halves) and
+// the axes, -65536..65536
+EMSCRIPTEN_KEEPALIVE void web_pad(uint32_t lo, uint32_t hi, int32_t forward, int32_t side, int32_t turn, int32_t pitch)
+{
+    webButtons = (uint64_t)hi << 32 | lo;
+    webCleared &= webButtons;
+    int32_t const in[4] = { forward, side, turn, pitch };
+    for (int i = 0; i < 4; i++)
+        webAxes[i] = (int32_t)((int64_t)clamp(in[i], -65536, 65536) * 32767 / 65536);
+}
+
+EMSCRIPTEN_KEEPALIVE void web_look(int32_t dx, int32_t dy)
+{
+    webLookX += dx;
+    webLookY += dy;
+}
+
+// A key, by SDL scancode, as if from the keyboard
+EMSCRIPTEN_KEEPALIVE void web_key(int scancode, int down)
+{
+    SDL_Event ev = {};
+    ev.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    ev.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+    ev.key.keysym.scancode = (SDL_Scancode)scancode;
+    ev.key.keysym.sym = SDL_GetKeyFromScancode((SDL_Scancode)scancode);
+    SDL_PushEvent(&ev);
+}
+
+}
+
+#endif
