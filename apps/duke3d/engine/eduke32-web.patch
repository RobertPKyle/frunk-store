--- /dev/null
+++ b/web/build.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+# [frunk] Builds EDuke32 (Duke Nukem 3D only) for the browser with
+# Emscripten 4.0.10, from the top of the source tree:
+#   web/build.sh [extra link flags]
+# Output: build-web/eduke32.js and .wasm, for frunk.store's Duke Nukem 3D
+# page (apps/duke3d in github.com/RobertPKyle/frunk-store).
+#
+# Instead of the GNUmakefile: the classic software renderer only (no
+# OpenGL), SDL2, no network play, and JSPI so the game's own loops can wait
+# for the page between frames (source/build/src/webhost.cpp).
+set -e
+OPT="${OPT:--O3}"
+INC="-Isource/build/include -Isource/audiolib/include -Isource/mact/include -Isource/glad/include -Isource/imgui/include -Isource/mimalloc/include -Isource/voidwrap/include"
+DEF="-DNOASM -DRENDERTYPESDL=1 -DSDL_TARGET=2 -DNDEBUG -DNETCODE_DISABLE -DB_LITTLE_ENDIAN=1 -DB_BIG_ENDIAN=0"
+CXXFLAGS="$OPT -std=gnu++14 -fno-exceptions -fno-rtti -fno-strict-aliasing -fwrapv -fno-threadsafe-statics -funsigned-char -sUSE_SDL=2 $DEF $INC -w"
+CFLAGS="$OPT -fno-strict-aliasing -fwrapv -funsigned-char -sUSE_SDL=2 $DEF $INC -w"
+
+BUILD="2d a-c baselayer cache1d clip colmatch common communityapi compat cpuid crc32 defs engine fix16 hash hightile klzw kplib loguru lz4 md4 mhk miniz miniz_tdef miniz_tinfl mmulti mutex osd palette pngwrite pragmas rev screenshot screentext scriptfile sdlayer sjson smalltextfont smmalloc smmalloc_generic smmalloc_tls softsurface texcache textfont tiles timer vfs webhost xxhash"
+DUKE="actors anim cheats cmdline common config demo dnames game gamedef gameexec gamestructures gamevars global grpscan input menus network osdcmds osdfuncs player premap rts savegame sbar screens sector sounds text web"
+AUDIO="driver_adlib driver_sdl driver_sf2 drivers flac formats fx_man gmtimbre midi mix mixst multivoc music opl3 pitch vorbis xa xmp"
+MACT="animlib control joystick keyboard scriplib"
+IMGUI="imgui imgui_draw imgui_tables imgui_widgets imgui_impl_sdl2"
+
+SRCS=""
+for n in $BUILD; do SRCS="$SRCS source/build/src/$n"; done
+for n in $DUKE; do SRCS="$SRCS source/duke3d/src/$n"; done
+for n in $AUDIO; do SRCS="$SRCS source/audiolib/src/$n"; done
+for n in $MACT; do SRCS="$SRCS source/mact/src/$n"; done
+for n in $IMGUI; do SRCS="$SRCS source/imgui/src/$n"; done
+SRCS="$SRCS source/duke3d/rsrc/eduke32_icon"
+
+mkdir -p build-web/obj
+OBJS=""
+LIST=""
+for s in $SRCS; do
+  if [ -f "$s.cpp" ]; then f="$s.cpp"; elif [ -f "$s.c" ]; then f="$s.c"; else echo "missing: $s"; exit 1; fi
+  o="build-web/obj/$(echo "$s" | tr / _).o"
+  OBJS="$OBJS $o"
+  LIST="$LIST $f:$o"
+done
+export CXXFLAGS CFLAGS
+echo $LIST | tr ' ' '\n' | xargs -P "$(nproc)" -I{} sh -c '
+  f="${1%%:*}"; o="${1#*:}"
+  case "$f" in *.cpp) em++ $CXXFLAGS -c "$f" -o "$o" ;; *) emcc $CFLAGS -c "$f" -o "$o" ;; esac
+' _ {}
+em++ $OPT $OBJS -o build-web/eduke32.js -sUSE_SDL=2 -sJSPI \
+  -sSTACK_SIZE=8388608 -sALLOW_MEMORY_GROWTH -sINITIAL_MEMORY=134217728 \
+  -sMODULARIZE -sEXPORT_ES6 -sEXPORT_NAME=createDuke -sENVIRONMENT=web \
+  -sINVOKE_RUN=0 -sEXIT_RUNTIME=0 -sFORCE_FILESYSTEM \
+  -sEXPORTED_RUNTIME_METHODS=FS,callMain,UTF8ToString,stringToNewUTF8 \
+  -sEXPORTED_FUNCTIONS=_main,_web_pad,_web_look,_web_key,_web_state,_web_frames,_web_autosave,_web_save_config,_web_cmd,_web_load_at_start,_malloc,_free \
+  "$@"
