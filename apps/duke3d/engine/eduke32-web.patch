diff --git a/source/duke3d/src/web.cpp b/source/duke3d/src/web.cpp
new file mode 100644
index 0000000..e55703d
--- /dev/null
+++ b/source/duke3d/src/web.cpp
@@ -0,0 +1,101 @@
+// [frunk] What frunk.store's Duke Nukem 3D page (apps/duke3d in
+// github.com/RobertPKyle/frunk-store) asks of the game: what's on the
+// screen, saving the game in progress when the page is left, loading it
+// again from Continue, and console commands for its settings. These run
+// while the game waits between frames, so they must never wait themselves
+// (webCalledIn).
+
+#ifdef __EMSCRIPTEN__
+
+#include "duke3d.h"
+#include "savegame.h"
+#include "osd.h"
+
+#include <emscripten.h>
+
+// The page's Continue save: one file, written over each time
+#define WEB_SAVE_FILE "continue.esv"
+
+static int webLoadAtStart;
+int webExiting;   // set by G_GameExit
+
+// Called at the top of the main loop: loads the Continue save if the page
+// asked for it before starting. Returns true when it did.
+bool webMaybeLoad(void)
+{
+    if (!webLoadAtStart)
+        return false;
+    webLoadAtStart = 0;
+
+    savebrief_t sv("Continue");
+    Bstrcpy(sv.path, WEB_SAVE_FILE);
+    KB_FlushKeyboardQueue();
+    KB_ClearKeysDown();
+    if (G_LoadPlayerMaybeMulti(sv) != 0)
+        return false;
+    g_lastusersave = sv;
+    g_quickload = &g_lastusersave;
+    Menu_Change(MENU_CLOSE);
+    return true;
+}
+
+extern "C" {
+
+// What's showing: 1 a menu, 2 a game being played, 4 a demo, a title
+// screen or the screens after quitting, 8 typing (chat or a cheat), 16 the
+// map, 32 the console, 64 the player is dead
+EMSCRIPTEN_KEEPALIVE int web_state(void)
+{
+    auto const ps = g_player[myconnectindex].ps;
+    if (!ps || webExiting)
+        return 4;
+    int const gm = ps->gm;
+    int s = 0;
+    if (gm & MODE_MENU) s |= 1;
+    if ((gm & MODE_GAME) && !(gm & MODE_DEMO)) s |= 2;
+    if (gm & MODE_DEMO || !(gm & MODE_GAME)) s |= 4;
+    if (gm & MODE_TYPE) s |= 8;
+    if (ud.overhead_on) s |= 16;
+    if (osd && (osd->flags & OSD_DRAW)) s |= 32;
+    if (ps->i >= 0 && sprite[ps->i].extra <= 0) s |= 64;
+    return s;
+}
+
+// Before main: load the Continue save once the game is up
+EMSCRIPTEN_KEEPALIVE void web_load_at_start(void) { webLoadAtStart = 1; }
+
+// Saves the game in progress as Continue; 1 when it did
+EMSCRIPTEN_KEEPALIVE int web_autosave(void)
+{
+    auto const ps = g_player[myconnectindex].ps;
+    if (!ps || !(ps->gm & MODE_GAME) || (ps->gm & (MODE_DEMO | MODE_EOL)) || ud.multimode > 1)
+        return 0;
+    if (ps->i < 0 || sprite[ps->i].extra <= 0)
+        return 0;
+
+    webCalledIn = 1;
+    savebrief_t sv("Continue");
+    Bstrcpy(sv.path, WEB_SAVE_FILE);
+    int const ok = G_SavePlayer(sv, false) == 0;
+    webCalledIn = 0;
+    return ok;
+}
+
+EMSCRIPTEN_KEEPALIVE void web_save_config(void)
+{
+    webCalledIn = 1;
+    CONFIG_WriteSetup(0);
+    webCalledIn = 0;
+}
+
+// A console command, such as a setting
+EMSCRIPTEN_KEEPALIVE void web_cmd(char const *text)
+{
+    webCalledIn = 1;
+    OSD_Dispatch(text, true);
+    webCalledIn = 0;
+}
+
+}
+
+#endif
