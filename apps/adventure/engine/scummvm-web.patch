+// frunk.store hooks. The page asks for an autosave when it is hidden or about
+// to close; the request is handled from the event loop, where engines also
+// make their timed autosaves. The page counts handled requests to know when
+// it's done. The autosave is skipped when the game can't save right now,
+// and when the autosave slot holds the player's own save, which the page
+// must never overwrite. Then web_last_save() says which slot holds an
+// autosave, made now or earlier, or -1 for none.
+static int webSaveRequests = 0;
+static int webSavesDone = 0;
+static int webLastSave = -1;
+
+extern "C" {
+void EMSCRIPTEN_KEEPALIVE web_request_save() {
+	webSaveRequests++;
+}
+
+int EMSCRIPTEN_KEEPALIVE web_saves_done() {
+	return webSavesDone;
+}
+
+int EMSCRIPTEN_KEEPALIVE web_last_save() {
+	return webLastSave;
+}
+}
+
+// What's in a save slot of the running game. Engines with their own save
+// format (Lure, for one) only describe their saves in listSaves().
+static SaveStateDescriptor webSaveInfo(int slot) {
+	const MetaEngine *metaEngine = g_engine->getMetaEngine();
+	const char *target = ConfMan.getActiveDomainName().c_str();
+	SaveStateDescriptor desc = metaEngine->querySaveMetaInfos(target, slot);
+	if (desc.isValid())
+		return desc;
+	SaveStateList saves = metaEngine->listSaves(target);
+	for (SaveStateList::const_iterator s = saves.begin(); s != saves.end(); ++s) {
+		if (s->getSaveSlot() == slot)
+			return *s;
+	}
+	return SaveStateDescriptor();
+}
+
+void webHandleSaveRequest() {
+	if (webSavesDone == webSaveRequests)
+		return;
+	int requests = webSaveRequests;
+	webLastSave = -1;
+	int slot = g_engine ? g_engine->getAutosaveSlot() : -1;
+	if (slot >= 0) {
+		SaveStateDescriptor desc = webSaveInfo(slot);
+		if ((!desc.isValid() || desc.isAutosave()) && g_engine->canSaveAutosaveCurrently())
+			g_engine->saveGameState(slot, Common::convertFromU32String(_("Autosave")), true);
+		desc = webSaveInfo(slot);
+		if (desc.isValid() && desc.isAutosave())
+			webLastSave = slot;
+	}
+	webSavesDone = requests;
+}
+
+EM_JS(void, webLauncherJS, (), {
+	if (Module['onLauncher'])
+		Module['onLauncher']();
+});
+
+void webLauncher() {
+	webLauncherJS();
+}
+
