 		cl.viewangles[PITCH] = oldAngles[PITCH] + 90;
diff --git a/code/client/cl_main.c b/code/client/cl_main.c
index d8c8c669..5b143269 100644
--- a/code/client/cl_main.c
+++ b/code/client/cl_main.c
@@ -125,6 +125,56 @@ cvar_t	*cl_rate;
 clientActive_t		cl;
 clientConnection_t	clc;
 clientStatic_t		cls;
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+
+// Called by the page (apps/openarena/openarena.js)
+
+// Runs console commands, as if typed
+EMSCRIPTEN_KEEPALIVE void web_cmd( const char *text ) {
+	Cbuf_AddText( text );
+	Cbuf_AddText( "\n" );
+}
+
+// A key (K_* in keycodes.h) going down or up
+EMSCRIPTEN_KEEPALIVE void web_key( int key, int down ) {
+	Com_QueueEvent( Sys_Milliseconds(), SE_KEY, key, down, 0, NULL );
+}
+
+// The mouse moving: turning in the game, the pointer in the menus
+EMSCRIPTEN_KEEPALIVE void web_mouse( int dx, int dy ) {
+	Com_QueueEvent( Sys_Milliseconds(), SE_MOUSE, dx, dy, 0, NULL );
+}
+
+// Puts the menus' pointer where the player tapped. It moves by how far the
+// mouse moved, so it goes to the top left corner first and then dx, dy from
+// there; called straight away, since queued mouse moves are added together.
+EMSCRIPTEN_KEEPALIVE void web_pointer( int dx, int dy ) {
+	if ( !uivm || !( Key_GetCatcher() & KEYCATCH_UI ) ) {
+		return;
+	}
+	VM_Call( uivm, UI_MOUSE_EVENT, -100000, -100000 );
+	VM_Call( uivm, UI_MOUSE_EVENT, dx, dy );
+}
+
+// What's on screen: the connection state (connstate_t) in the low byte, the
+// key catchers (KEYCATCH_*) in the next, then the player's pm_type
+// (PM_DEAD, PM_INTERMISSION...) once a snapshot has arrived, plus one
+EMSCRIPTEN_KEEPALIVE int web_state( void ) {
+	int pm = ( clc.state == CA_ACTIVE && cl.snap.valid ) ? cl.snap.ps.pm_type + 1 : 0;
+	return clc.state | ( Key_GetCatcher() & 0xff ) << 8 | pm << 16;
+}
+
+void Com_WriteConfigToFile( const char *filename );
+
+// Saves the settings now (q3config.cfg), for the page to keep
+EMSCRIPTEN_KEEPALIVE void web_writeconfig( void ) {
+	if ( com_fullyInitialized ) {
+		Com_WriteConfigToFile( Q3CONFIG_CFG );
+	}
+}
+#endif
 vm_t				*cgvm;
 
 char				cl_reconnectArgs[MAX_OSPATH];
