index cfdaa1d1..8b51c1e4 100644
--- a/code/client/cl_input.c
+++ b/code/client/cl_input.c
@@ -575,6 +575,38 @@ void CL_FinishMove( usercmd_t *cmd ) {
 CL_CreateCmd
 =================
 */
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+
+// Walking and turning from the page's on-screen controls and controllers
+// (apps/openarena/openarena.js): forward and side from -1 to 1, yaw and
+// pitch in degrees per second (sticks), and turns in degrees to add once
+// (a finger dragged on the screen)
+static float web_forward, web_side, web_yaw, web_pitch, web_turnYaw, web_turnPitch;
+
+EMSCRIPTEN_KEEPALIVE void web_move( float forward, float side, float yaw, float pitch ) {
+	web_forward = forward;
+	web_side = side;
+	web_yaw = yaw;
+	web_pitch = pitch;
+}
+
+EMSCRIPTEN_KEEPALIVE void web_look( float yaw, float pitch ) {
+	web_turnYaw += yaw;
+	web_turnPitch += pitch;
+}
+
+static void CL_WebMove( usercmd_t *cmd ) {
+	float frame = cls.frametime * 0.001f;
+
+	cl.viewangles[YAW] -= web_yaw * frame + web_turnYaw;
+	cl.viewangles[PITCH] += web_pitch * frame + web_turnPitch;
+	web_turnYaw = web_turnPitch = 0;
+	cmd->forwardmove = ClampChar( cmd->forwardmove + (int)( web_forward * 127 ) );
+	cmd->rightmove = ClampChar( cmd->rightmove + (int)( web_side * 127 ) );
+}
+#endif
+
 usercmd_t CL_CreateCmd( void ) {
 	usercmd_t	cmd;
 	vec3_t		oldAngles;
