diff --git a/web/build.sh b/web/build.sh
new file mode 100755
index 0000000..cb80a5e
--- /dev/null
+++ b/web/build.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# [frunk] Builds Vanilla Conquer's Tiberian Dawn and Red Alert for the
+# browser with Emscripten 4.0.10, from the top of the source tree:
+#   web/build.sh
+# Output: build-web/vanillatd.{js,wasm} and build-web/vanillara.{js,wasm},
+# for frunk.store's Command & Conquer page (apps/cnc in
+# github.com/RobertPKyle/frunk-store).
+#
+# SDL2 and OpenAL from Emscripten, no network play, and JSPI so the games'
+# own loops can wait for the page between frames (common/webhost.cpp).
+set -e
+git config --global --add safe.directory "$(pwd)" 2>/dev/null || true
+LINK="-g0 -sJSPI -sENVIRONMENT=web -sALLOW_MEMORY_GROWTH -sINITIAL_MEMORY=67108864 -sSTACK_SIZE=4194304 \
+  -sMODULARIZE -sEXPORT_ES6 -sEXPORT_NAME=createConquer -sINVOKE_RUN=0 -sEXIT_RUNTIME=1 -sFORCE_FILESYSTEM -lidbfs.js \
+  -sEXPORTED_RUNTIME_METHODS=FS,IDBFS,callMain,addRunDependency,removeRunDependency \
+  -sEXPORTED_FUNCTIONS=_main,_web_key,_web_scroll,_web_frames"
+emcmake cmake -S . -B build-web -DCMAKE_BUILD_TYPE=Release -DNETWORKING=OFF -DBUILD_TOOLS=OFF \
+  -DCMAKE_EXE_LINKER_FLAGS="$LINK" >/dev/null
+cmake --build build-web -j"$(nproc)" --target VanillaTD VanillaRA
