diff --git a/common/webhost.cpp b/common/webhost.cpp
new file mode 100644
index 0000000..5280ade
--- /dev/null
+++ b/common/webhost.cpp
@@ -0,0 +1,75 @@
+// [frunk] The browser side of the engine, for frunk.store's Command &
+// Conquer page (apps/cnc in github.com/RobertPKyle/frunk-store).
+//
+// The game's loops run as they do natively, inside main(); with JSPI, main
+// waits for the page between frames (webWaitFrame, one per screen refresh)
+// and, in loops that only poll the keyboard, every so often (webYield), so
+// the page stays responsive. Functions the page calls (web_*) must never
+// wait: they run while main is waiting.
+
+#ifdef __EMSCRIPTEN__
+
+#include <SDL.h>
+#include <emscripten.h>
+
+// Resolved by the page on its next animation frame
+EM_ASYNC_JS(void, webWaitFrameJS, (void), { await Module.webFrame(); });
+
+static double webLastWait;
+static int webFrameCount;
+
+void webWaitFrame()
+{
+    webFrameCount++;
+    webWaitFrameJS();
+    webLastWait = emscripten_get_now();
+}
+
+// A loop that polls the keyboard without drawing waits a frame now and then
+void webYield()
+{
+    if (emscripten_get_now() - webLastWait < 16) {
+        return;
+    }
+    webWaitFrameJS();
+    webLastWait = emscripten_get_now();
+}
+
+// Finger drags on the page, in game pixels, until the map takes them
+static int webScrollX, webScrollY;
+
+bool webTakeScroll(int& dx, int& dy)
+{
+    dx = webScrollX;
+    dy = webScrollY;
+    webScrollX = webScrollY = 0;
+    return dx || dy;
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int web_frames(void)
+{
+    return webFrameCount;
+}
+
+// A key, by SDL scancode, as if from the keyboard
+EMSCRIPTEN_KEEPALIVE void web_key(int scancode, int down)
+{
+    SDL_Event ev = {};
+    ev.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    ev.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+    ev.key.keysym.scancode = (SDL_Scancode)scancode;
+    ev.key.keysym.sym = SDL_GetKeyFromScancode((SDL_Scancode)scancode);
+    SDL_PushEvent(&ev);
+}
+
+// Moves the map by this many game pixels (a finger dragging it)
+EMSCRIPTEN_KEEPALIVE void web_scroll(int dx, int dy)
+{
+    webScrollX += dx;
+    webScrollY += dy;
+}
+}
+
+#endif
