diff --git a/game/Web.cpp b/game/Web.cpp
new file mode 100644
index 0000000..53172e0
--- /dev/null
+++ b/game/Web.cpp
@@ -0,0 +1,93 @@
+// What the page calls: frunk.store's web build reads touch and controllers in
+// JavaScript and passes them on through these functions.
+#if defined(EMSCRIPTEN)
+#include <string>
+
+#include <SDL.h>
+#include <emscripten.h>
+
+#include "Trace.hpp"
+#include "Config.hpp"
+#include "Context.hpp"
+#include "GameState.hpp"
+#include "Hero.hpp"
+#include "Input.hpp"
+#include "MenuManager.hpp"
+#include "ScoreKeeper.hpp"
+#include "Video.hpp"
+
+extern "C" {
+
+// a key, as the game's own bindings and menus read it
+EMSCRIPTEN_KEEPALIVE void web_key(int sym, int down) {
+    SDL_Event e;
+    SDL_memset(&e, 0, sizeof(e));
+    e.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    e.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+    e.key.keysym.sym = sym;
+    e.key.keysym.scancode = SDL_GetScancodeFromKey(sym);
+    SDL_PushEvent(&e);
+}
+
+// a press of the left mouse button, which the menus use
+EMSCRIPTEN_KEEPALIVE void web_mouse_button(int button, int down) {
+    SDL_Event e;
+    SDL_memset(&e, 0, sizeof(e));
+    e.type = down ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+    e.button.button = button;
+    e.button.state = down ? SDL_PRESSED : SDL_RELEASED;
+    SDL_PushEvent(&e);
+}
+
+// moves the ship by pixels of the drawing, as the mouse does
+EMSCRIPTEN_KEEPALIVE void web_move(float dx, float dy) {
+    if (GameState::context == Context::eInGame) {
+        HeroS::instance()->move(dx, dy);
+    }
+}
+
+// the menu pointer, in fractions of the picture from the top left
+EMSCRIPTEN_KEEPALIVE void web_menu_point(float x, float y) {
+    if (GameState::context == Context::eMenu) {
+        MenuManagerS::instance()->webPoint(x * 1000.0f, 750.0f - y * 750.0f);
+    }
+}
+
+// bits 0-2: the context (1 menu, 2 in game, 3 paused, 4 camera);
+// 8: the ship is alive; 16: the top-ten name is wanted
+EMSCRIPTEN_KEEPALIVE int web_state(void) {
+    int state = (int)GameState::context;
+    if (HeroS::instance()->alive()) {
+        state |= 8;
+    }
+    if (VideoS::instance()->webNameWanted()) {
+        state |= 16;
+    }
+    return state;
+}
+
+EMSCRIPTEN_KEEPALIVE float web_hero_x(void) {
+    return HeroS::instance()->webX();
+}
+
+EMSCRIPTEN_KEEPALIVE float web_energy(void) {
+    return HeroS::instance()->webEnergy();
+}
+
+EMSCRIPTEN_KEEPALIVE int web_score(void) {
+    return ScoreKeeperS::instance()->getCurrentScore();
+}
+
+// the name for a top-ten finish, then back to the menu as Enter would
+EMSCRIPTEN_KEEPALIVE void web_name(const char* name) {
+    VideoS::instance()->webSetName(name);
+}
+
+// writes settings and scores to their files; the page then syncs IndexedDB
+EMSCRIPTEN_KEEPALIVE void web_save(void) {
+    ConfigS::instance()->saveToFile();
+    ScoreKeeperS::instance()->save();
+}
+
+}  // extern "C"
+#endif
