+// frunk.store: saves the NVRAM (high scores, settings) and configuration at
+// once, for a page that's being left and won't get another frame
+void running_machine::emscripten_save_nvram() {
+	running_machine *machine = emscripten_running_machine;
+	if (!machine || machine->exit_pending())
+		return;
+	if (machine->options().nvram_save())
+		machine->nvram_save();
+	machine->m_configuration->save_settings();
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void web_save() {
+	running_machine::emscripten_save_nvram();
+}
