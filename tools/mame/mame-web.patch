-		const attotime frametime(0,HZ_TO_ATTOSECONDS(60));
+		// Emscripten calls this once per animation frame: step the simulation
+		// forward for the real time that has passed since the last call
+		// (frunk.store: the browser's frame rate isn't always 60 Hz, and the
+		// car's can drop below it), at most a tenth of a second
+		static double last_ms = 0;
+		const double now_ms = emscripten_get_now();
+		double step = last_ms > 0 ? (now_ms - last_ms) / 1000.0 : 1.0 / 60;
+		last_ms = now_ms;
+		if (step < 0 || step > 0.1) step = step < 0 ? 0 : 0.1;
+		const attotime frametime = attotime::from_double(step);
 		const attotime stoptime(scheduler->time() + frametime);
 
