--- pristine/src/web.c
+++ src/src/web.c
@@ -0,0 +1,68 @@
+// frunk.store: small hooks for the page (apps/rocks/rocks.js).
+#include <emscripten.h>
+
+#include "main.h"
+#include "game.h"
+#include "tape.h"
+#include "tools.h"
+#include "files.h"
+#include "game_em/export_em.h"
+
+// 0 elsewhere, 1 in the menus, 2 playing
+EMSCRIPTEN_KEEPALIVE int web_state(void)
+{
+  return (game_status == GAME_MODE_PLAYING ? 2 :
+	  game_status == GAME_MODE_MAIN ? 1 : 0);
+}
+
+EMSCRIPTEN_KEEPALIVE int web_level(void)	{ return level_nr; }
+EMSCRIPTEN_KEEPALIVE int web_paused(void)	{ return (tape.pausing ? 1 : 0); }
+EMSCRIPTEN_KEEPALIVE int web_frames(void)	{ return FrameCounter; }
+EMSCRIPTEN_KEEPALIVE int web_engine(void)	{ return level.game_engine_type; }
+
+EMSCRIPTEN_KEEPALIVE int web_player_x(void)
+{
+  if (game_status != GAME_MODE_PLAYING)
+    return -1;
+  return (level.game_engine_type == GAME_ENGINE_TYPE_EM ? game_em.ply[0]->x : local_player->jx);
+}
+
+EMSCRIPTEN_KEEPALIVE int web_player_y(void)
+{
+  if (game_status != GAME_MODE_PLAYING)
+    return -1;
+  return (level.game_engine_type == GAME_ENGINE_TYPE_EM ? game_em.ply[0]->y : local_player->jy);
+}
+
+EMSCRIPTEN_KEEPALIVE int web_solved(void)	{ return (game_status == GAME_MODE_PLAYING && game.LevelSolved ? 1 : 0); }
+
+// Reports which elements each level of the named set uses, for the build check
+// that no level leans on a blanked sheet: prints "scan <level> <token> <file>"
+// for every element whose graphic comes from a sheet in the list of names.
+EMSCRIPTEN_KEEPALIVE void web_scan(const char *set, const char *sheets)
+{
+  TreeInfo *node = getTreeInfoFromIdentifier(leveldir_first, (char *)set);
+  if (node == NULL) { EM_ASM({ console.log('scan none', UTF8ToString($0)); }, set); return; }
+  leveldir_current = node;
+  EM_ASM({ console.log('scan set', UTF8ToString($0), $1, $2); }, set, node->first_level, node->last_level);
+  for (int nr = node->first_level; nr <= node->last_level; nr++)
+  {
+    LoadLevel(nr);
+    static char seen[MAX_NUM_ELEMENTS + 1];
+    memset(seen, 0, sizeof(seen));
+    for (int y = 0; y < level.fieldy; y++)
+      for (int x = 0; x < level.fieldx; x++)
+	seen[level.field[x][y]] = 1;
+    for (int e = 0; e <= MAX_NUM_ELEMENTS; e++)
+    {
+      if (!seen[e])
+	continue;
+      struct FileInfo *fi = getImageListEntryFromImageID(el2img(e));
+      char *file = fi && fi->filename ? fi->filename : "";
+      char *base = strrchr(file, '/');
+      base = base ? base + 1 : file;
+      if (strstr(sheets, base))
+	EM_ASM({ console.log('scan', $0, $1, UTF8ToString($2), UTF8ToString($3)); }, nr, e, element_info[e].token_name, base);
+    }
+  }
+}
