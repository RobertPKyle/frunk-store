+// frunk.store's web build has no network play and no high score server, so
+// SDL_net isn't linked. Everything that would use it gets a failure at once.
+#ifndef SDL_NET_STUB_H
+#define SDL_NET_STUB_H
+
+#include <SDL_version.h>
+
+typedef struct { unsigned int host; unsigned short port; } IPaddress;
+typedef void *TCPsocket;
+typedef void *UDPsocket;
+typedef void *SDLNet_SocketSet;
+typedef struct { int channel; unsigned char *data; int len; int maxlen; int status; IPaddress address; } UDPpacket;
+
+#define SDLNET_MAX_UDPCHANNELS 32
+#ifndef INADDR_NONE
+#define INADDR_NONE 0xFFFFFFFFu
+#endif
+
+#define SDL_NET_VERSION(x) SDL_VERSION(x)
+static inline const SDL_version *SDLNet_Linked_Version(void) { static SDL_version v = { 0, 0, 0 }; return &v; }
+
+static inline int SDLNet_Init(void) { return -1; }
+static inline const char *SDLNet_GetError(void) { return "no network in this build"; }
+static inline int SDLNet_ResolveHost(IPaddress *a, const char *h, unsigned short p) { (void)a; (void)h; (void)p; return -1; }
+static inline unsigned int SDLNet_Read32(const void *p) { (void)p; return 0; }
+static inline void SDLNet_Write32(unsigned int v, void *p) { (void)v; (void)p; }
+static inline void SDLNet_Write16(unsigned short v, void *p) { (void)v; (void)p; }
+static inline SDLNet_SocketSet SDLNet_AllocSocketSet(int n) { (void)n; return NULL; }
+static inline void SDLNet_FreeSocketSet(SDLNet_SocketSet s) { (void)s; }
+static inline int SDLNet_TCP_AddSocket(SDLNet_SocketSet s, TCPsocket t) { (void)s; (void)t; return -1; }
+static inline int SDLNet_TCP_DelSocket(SDLNet_SocketSet s, TCPsocket t) { (void)s; (void)t; return -1; }
+static inline int SDLNet_UDP_AddSocket(SDLNet_SocketSet s, UDPsocket t) { (void)s; (void)t; return -1; }
+static inline int SDLNet_UDP_DelSocket(SDLNet_SocketSet s, UDPsocket t) { (void)s; (void)t; return -1; }
+static inline TCPsocket SDLNet_TCP_Open(IPaddress *a) { (void)a; return NULL; }
+static inline TCPsocket SDLNet_TCP_Accept(TCPsocket t) { (void)t; return NULL; }
+static inline IPaddress *SDLNet_TCP_GetPeerAddress(TCPsocket t) { (void)t; return NULL; }
+static inline void SDLNet_TCP_Close(TCPsocket t) { (void)t; }
+static inline int SDLNet_TCP_Send(TCPsocket t, const void *d, int n) { (void)t; (void)d; (void)n; return -1; }
+static inline int SDLNet_TCP_Recv(TCPsocket t, void *d, int n) { (void)t; (void)d; (void)n; return -1; }
+static inline int SDLNet_CheckSockets(SDLNet_SocketSet s, unsigned int ms) { (void)s; (void)ms; return -1; }
+static inline int SDLNet_SocketReady(void *s) { (void)s; return 0; }
+static inline UDPsocket SDLNet_UDP_Open(unsigned short p) { (void)p; return NULL; }
+static inline void SDLNet_UDP_Close(UDPsocket u) { (void)u; }
+static inline int SDLNet_UDP_Recv(UDPsocket u, UDPpacket *p) { (void)u; (void)p; return -1; }
+static inline int SDLNet_UDP_Send(UDPsocket u, int c, UDPpacket *p) { (void)u; (void)c; (void)p; return 0; }
+static inline UDPpacket *SDLNet_AllocPacket(int n) { (void)n; return NULL; }
+static inline void SDLNet_FreePacket(UDPpacket *p) { (void)p; }
+
+#endif
