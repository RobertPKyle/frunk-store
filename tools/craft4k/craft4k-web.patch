Minecraft4k-CPP for the browser (tools/build-craft4k.mjs applies this to
commit cfb537a): GLES 3 headers in place of glad, no GL debug callback,
the texture atlas packed as RGBA (WebGL can't upload BGRA), and the world
generator no longer writes one column past the end of the world.

diff --git a/TextureGenerator.cpp b/TextureGenerator.cpp
index 53f4802..70cf85b 100644
--- a/TextureGenerator.cpp
+++ b/TextureGenerator.cpp
@@ -98,9 +98,9 @@ GLuint generateTextures(long long seed)
 
                 // multiply tint by the grayscale detail
                 const int col = ((tint & 0xFFFFFF) == 0 ? 0 : 0xFF) << 24 |
-                    (tint >> 16 & 0xFF) * gsd_constexpr / 0xFF << 16 |
+                    (tint >> 16 & 0xFF) * gsd_constexpr / 0xFF << 0 |
                     (tint >> 8 & 0xFF) * gsd_constexpr / 0xFF << 8 |
-                    (tint & 0xFF) * gsd_constexpr / 0xFF << 0;
+                    (tint & 0xFF) * gsd_constexpr / 0xFF << 16; // RGBA in memory
 
                 // write pixel to the texture atlas
                 textureAtlas[x + (TEXTURE_RES * blockID) + y * (TEXTURE_RES * 16)] = col;
@@ -120,7 +120,7 @@ GLuint generateTextures(long long seed)
     glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
 
     glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, TEXTURE_RES * 16, TEXTURE_RES * 3);
-    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, TEXTURE_RES * 16, TEXTURE_RES * 3, GL_BGRA, GL_UNSIGNED_BYTE, textureAtlas);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, TEXTURE_RES * 16, TEXTURE_RES * 3, GL_RGBA, GL_UNSIGNED_BYTE, textureAtlas);
     glGenerateMipmap(GL_TEXTURE_2D);
     glBindTexture(GL_TEXTURE_2D, 0);
 
