   set(HAVE_OPENGL ON CACHE BOOL "")
diff --git a/mk/cmake/SuperTux/WebDeps.cmake b/mk/cmake/SuperTux/WebDeps.cmake
new file mode 100644
index 0000000..42aa2b9
--- /dev/null
+++ b/mk/cmake/SuperTux/WebDeps.cmake
@@ -0,0 +1,17 @@
+# The libraries Emscripten has as ports, as targets add_package() finds
+# ready-made (it skips a package whose target exists)
+foreach(port PNG:-sUSE_LIBPNG=1 ZLIB:-sUSE_ZLIB=1 Freetype:-sUSE_FREETYPE=1)
+  string(REPLACE ":" ";" port "${port}")
+  list(GET port 0 name)
+  list(GET port 1 flag)
+  add_library(${name} INTERFACE IMPORTED)
+  set_target_properties(${name} PROPERTIES
+    INTERFACE_COMPILE_OPTIONS "${flag}"
+    INTERFACE_LINK_LIBRARIES "${flag}")
+endforeach()
+
+# PhysFS, built for the web next to the game (add_package() would ask
+# pkg-config for it)
+find_package(PhysFS CONFIG REQUIRED)
+add_library(PhysFS INTERFACE IMPORTED)
+set_target_properties(PhysFS PROPERTIES INTERFACE_LINK_LIBRARIES PhysFS::PhysFS-static)
