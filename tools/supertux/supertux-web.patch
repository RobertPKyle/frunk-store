+// frunk.store: the page's Touch/Controller button shows (1) or hides (0) the
+// on-screen touch controls at once, mid-level too (upstream decides only as
+// the game starts)
+EMSCRIPTEN_KEEPALIVE
+void
+web_set_mobile_controls(int on)
+{
+  // (before the game has read its options there is nothing to switch: it
+  // reads Module.touchControls as it starts)
+  if (!g_config || g_config->mobile_controls == (on != 0))
+    return;
+  g_config->mobile_controls = (on != 0);
+  // A button held on the touch controls as they go would otherwise stay
+  // held, as nothing reads them any more: let go of everything (a held
+  // controller button counts again at its next change)
+  if (!on && InputManager::current())
+    InputManager::current()->get_controller().reset();
+  // the picture's scale depends on it (see calculate_scale in viewport.cpp)
+  if (VideoSystem::current())
+  {
+    const Size size = VideoSystem::current()->get_window_size();
+    set_resolution(size.width, size.height);
+  }
+}
+
+// 1 while the touch controls are on (for the page's end-to-end check)
+EMSCRIPTEN_KEEPALIVE
+int
+web_mobile_controls()
+{
+  return g_config && g_config->mobile_controls ? 1 : 0;
+}
