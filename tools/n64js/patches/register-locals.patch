index 0000000..4c07948
--- /dev/null
+++ b/src/cpu/register_locals.js
@@ -0,0 +1,373 @@
+import * as decode from './decode.js';
+
+// Keeps the registers a fragment uses in local variables, which V8 can hold
+// in machine registers: the typed arrays the registers live in have to be
+// reloaded after every call the fragment makes, even ones on paths not taken.
+//
+//   $g0..$g63  the words of c.gprS32 (the GPRs' low and high halves)
+//   $f0..$f62  the even words of cpu1.regF32, as floats (the single in each
+//              FPR's low word, wherever the FR mode puts the register)
+//   $fcsr      cpu1.control[31] (FCSR), as an int32
+//
+// Stores still go to the arrays as well (write-through), so a local always
+// equals its register: exits need nothing written back, and helpers read and
+// write the arrays as before. After a helper that may write a register, the
+// register is read back into its local.
+//
+// A local is loaded where the fragment first touches it, unless that touch
+// overwrites it. Self-looping fragments load them ahead of the loop instead.
+export class RegisterLocals {
+  constructor() {
+    this.reset();
+  }
+
+  reset() {
+    this.touched = new Map();      // local -> its load, or null if first written
+    this.pending = '';             // loads to emit ahead of the current op
+    this.loads = [];               // every load statement emitted
+    this.written = new Set();      // locals the current op wrote through
+    this.reloadedAll = false;      // whether some helper's writes were unknown
+    this.arrays = new Set();       // array locals declared
+  }
+
+  touch(name, array, load) {
+    if (this.touched.has(name)) {
+      return;
+    }
+    if (array && !this.arrays.has(array)) {
+      this.arrays.add(array);
+      this.emitLoad(`var ${array} = ${kArrays[array]};\n`);
+    }
+    this.touched.set(name, load);
+    if (load) {
+      this.emitLoad(`var ${name} = ${load};\n`);
+    } else {
+      // (just declared, never global; hoisting adds its own declaration)
+      this.pending += `var ${name};\n`;
+    }
+  }
+
+  emitLoad(code) {
+    this.pending += code;
+    this.loads.push(code);
+  }
+
+  // The loads the code generated since the last call needs, to be emitted
+  // ahead of it (at the fragment's top level)
+  takePending() {
+    const code = this.pending;
+    this.pending = '';
+    return code;
+  }
+
+  // ---- GPR words ----
+
+  readS32(word) {
+    this.touch(`$g${word}`, '$gpr', `$gpr[${word}]`);
+    return `$g${word}`;
+  }
+
+  readU32(word) {
+    return `(${this.readS32(word)} >>> 0)`;
+  }
+
+  // A store run on every path through the current op (expr is an int32)
+  write(word, expr) {
+    this.touch(`$g${word}`, '$gpr', null);
+    this.written.add(`$g${word}`);
+    return `$gpr[${word}] = $g${word} = ${expr};`;
+  }
+
+  // A store run on some paths only
+  writeConditional(word, expr) {
+    this.readS32(word);
+    return `$gpr[${word}] = $g${word} = ${expr};`;
+  }
+
+  reload(word) {
+    this.touch(`$g${word}`, '$gpr', null);
+    return `$g${word} = $gpr[${word}];`;
+  }
+
+  // ---- COP1 words (even ones) ----
+
+  readF32(word) {
+    this.touch(`$f${word}`, '$fpr', `$fpr[${word}]`);
+    return `$f${word}`;
+  }
+
+  // A store on some paths only (expr is a float32's value)
+  writeF32Conditional(word, expr) {
+    this.readF32(word);
+    return `$fpr[${word}] = $f${word} = ${expr};`;
+  }
+
+  reloadF32(word) {
+    this.touch(`$f${word}`, '$fpr', null);
+    return `$f${word} = $fpr[${word}];`;
+  }
+
+  // Reloads the locals of words written some other way (see cop1WritesOf)
+  reloadF32Words(words) {
+    let code = '';
+    for (const word of words) {
+      if (!this.written.has(`$f${word}`)) {
+        code += `${this.reloadF32(word)}\n`;
+      }
+    }
+    return code;
+  }
+
+  // ---- FCSR ----
+
+  readFCSR() {
+    this.touch('$fcsr', null, 'cpu1.control[31] | 0');
+    return '$fcsr';
+  }
+
+  // A store on some paths only (expr is an int32)
+  writeFCSRConditional(expr) {
+    this.readFCSR();
+    return `cpu1.control[31] = $fcsr = ${expr};`;
+  }
+
+  reloadFCSR() {
+    this.touch('$fcsr', null, null);
+    return '$fcsr = cpu1.control[31] | 0;';
+  }
+
+  // Marks locals as written on every path through the current op (through,
+  // or by reloading them where a helper wrote them)
+  markWritten(...names) {
+    for (const name of names) {
+      this.written.add(name);
+    }
+  }
+
+  // Reloads the registers an instruction may have written by a helper (the
+  // ones the current op didn't write through), then starts the next op.
+  // Locals not touched yet are loaded too: a load ahead of a self-loop would
+  // miss the helper's write.
+  finishOp(instruction) {
+    let code = '';
+    const gprs = gprWritesOf(instruction);
+    if (gprs === null) {
+      this.reloadedAll = true;
+      for (const name of this.touched.keys()) {
+        if (!this.written.has(name)) {
+          code += `${this.reloadLocal(name)}\n`;
+        }
+      }
+    } else {
+      for (const reg of gprs) {
+        for (const word of [reg * 2, reg * 2 + 1]) {
+          if (!this.written.has(`$g${word}`)) {
+            code += `${this.reload(word)}\n`;
+          }
+        }
+      }
+      const cop1 = cop1WritesOf(instruction);
+      code += this.reloadF32Words(cop1.words);
+      if (cop1.fcsr && !this.written.has('$fcsr')) {
+        code += `${this.reloadFCSR()}\n`;
+      }
+    }
+    this.written.clear();
+    return code;
+  }
+
+  reloadLocal(name) {
+    if (name === '$fcsr') {
+      return this.reloadFCSR();
+    }
+    const word = Number(name.slice(2));
+    return name.startsWith('$g') ? this.reload(word) : this.reloadF32(word);
+  }
+
+  // A self-looping fragment's body with its loads moved ahead of the loop
+  // (locals first touched by a store start at 0 rather than undefined, so the
+  // loop doesn't merge the two). Not when some helper's writes were unknown:
+  // its reload only covers the locals touched before it.
+  hoist(body) {
+    if (this.reloadedAll || this.loads.length === 0) {
+      return { header: '', body };
+    }
+    let header = '';
+    for (const load of this.loads) {
+      body = body.replace(load, '');
+      header += load;
+    }
+    for (const [name, load] of this.touched) {
+      if (!load) {
+        header += `var ${name} = 0;\n`;
+      }
+    }
+    return { header, body };
+  }
+}
+
+const kArrays = {
+  $gpr: 'c.gprS32',
+  $fpr: 'cpu1.regF32',
+};
+
+// The GPRs an instruction can write (besides $r0), or null if that's not
+// known. Exceptions don't count: they leave the fragment.
+export function gprWritesOf(instruction) {
+  const rt = decode.rt(instruction);
+  const rd = decode.rd(instruction);
+  const ra = 31;
+  const nonZero = (...regs) => regs.filter(r => r !== 0);
+  switch (decode.simpleOp(instruction)) {
+    case decode.OP_SPECIAL:
+      switch (decode.specialOp(instruction)) {
+        case decode.SPECIAL_JR:
+        case decode.SPECIAL_SYSCALL:
+        case decode.SPECIAL_BREAK:
+        case decode.SPECIAL_SYNC:
+        case decode.SPECIAL_MTHI:
+        case decode.SPECIAL_MTLO:
+        case decode.SPECIAL_MULT:
+        case decode.SPECIAL_MULTU:
+        case decode.SPECIAL_DIV:
+        case decode.SPECIAL_DIVU:
+        case decode.SPECIAL_DMULT:
+        case decode.SPECIAL_DMULTU:
+        case decode.SPECIAL_DDIV:
+        case decode.SPECIAL_DDIVU:
+        case decode.SPECIAL_TGE:
+        case decode.SPECIAL_TGEU:
+        case decode.SPECIAL_TLT:
+        case decode.SPECIAL_TLTU:
+        case decode.SPECIAL_TEQ:
+        case decode.SPECIAL_TNE:
+          return [];
+        default:
+          return nonZero(rd);
+      }
+    case decode.OP_REGIMM:
+      switch (decode.regImmOp(instruction)) {
+        case decode.REGIMM_BLTZAL:
+        case decode.REGIMM_BGEZAL:
+        case decode.REGIMM_BLTZALL:
+        case decode.REGIMM_BGEZALL:
+          return [ra];
+        default:
+          return [];
+      }
+    case decode.OP_JAL:
+      return [ra];
+    case decode.OP_J:
+    case decode.OP_BEQ:
+    case decode.OP_BNE:
+    case decode.OP_BLEZ:
+    case decode.OP_BGTZ:
+    case decode.OP_BEQL:
+    case decode.OP_BNEL:
+    case decode.OP_BLEZL:
+    case decode.OP_BGTZL:
+    case decode.OP_SB:
+    case decode.OP_SH:
+    case decode.OP_SWL:
+    case decode.OP_SW:
+    case decode.OP_SDL:
+    case decode.OP_SDR:
+    case decode.OP_SWR:
+    case decode.OP_SD:
+    case decode.OP_CACHE:
+    case decode.OP_LWC1:
+    case decode.OP_LDC1:
+    case decode.OP_SWC1:
+    case decode.OP_SDC1:
+    case decode.OP_LWC2:
+    case decode.OP_LDC2:
+    case decode.OP_SWC2:
+    case decode.OP_SDC2:
+    case decode.OP_COP3:
+      return [];
+    case decode.OP_ADDI:
+    case decode.OP_ADDIU:
+    case decode.OP_SLTI:
+    case decode.OP_SLTIU:
+    case decode.OP_ANDI:
+    case decode.OP_ORI:
+    case decode.OP_XORI:
+    case decode.OP_LUI:
+    case decode.OP_DADDI:
+    case decode.OP_DADDIU:
+    case decode.OP_LDL:
+    case decode.OP_LDR:
+    case decode.OP_LB:
+    case decode.OP_LH:
+    case decode.OP_LWL:
+    case decode.OP_LW:
+    case decode.OP_LBU:
+    case decode.OP_LHU:
+    case decode.OP_LWR:
+    case decode.OP_LWU:
+    case decode.OP_LL:
+    case decode.OP_LLD:
+    case decode.OP_LD:
+    case decode.OP_SC:
+    case decode.OP_SCD:
+      return nonZero(rt);
+    case decode.OP_COP0:
+    case decode.OP_COP1:
+    case decode.OP_COP2:
+      // MFCz, DMFCz, CFCz and DCFCz write rt; the other coprocessor
+      // instructions write no GPR
+      if ((instruction & 0x02000000) === 0 && decode.copOp(instruction) < 4) {
+        return nonZero(rt);
+      }
+      return [];
+    default:
+      return null;
+  }
+}
+
+// The even COP1 words an instruction can write, and whether it can write
+// FCSR (only asked once gprWritesOf has said the instruction is known). A
+// 32-bit write to register r through an fd or ft field (as cpu1's regIdx32_d
+// and regIdx32_t) is to word 2r, and so is a 64-bit one (regIdx64_d); through
+// an fs field of a move or load (regIdx32_cop), it's word 2r, or with FR
+// clear and r odd, the high word below (not kept), and a 64-bit one
+// (regIdx64_cop) is to 2r's words, or with FR clear, those of r & ~1.
+export function cop1WritesOf(instruction) {
+  switch (decode.simpleOp(instruction)) {
+    case decode.OP_LWC1:
+      return cop1Words32(decode.rt(instruction));
+    case decode.OP_LDC1:
+      return cop1Words64(decode.rt(instruction));
+    case decode.OP_COP1:
+      if ((instruction & 0x02000000) !== 0) {
+        // arithmetic, conversions and moves; compares write FCSR alone, and
+        // moves don't
+        const funct = instruction & 0x3f;
+        return { words: funct >= 0x30 ? [] : [decode.fd(instruction) * 2], fcsr: funct !== kFunctMov };
+      }
+      switch (decode.copOp(instruction)) {
+        case decode.COP_MT:
+          return cop1Words32(decode.fs(instruction));
+        case decode.COP_DMT:
+          return cop1Words64(decode.fs(instruction));
+        case decode.COP_CT:
+        case decode.COP_DCT:
+          return { words: [], fcsr: true };
+        default:
+          return kNoCop1Writes;
+      }
+    default:
+      return kNoCop1Writes;
+  }
+}
+
+export function cop1Words32(reg) {
+  return { words: [reg * 2], fcsr: false };
+}
+
+export function cop1Words64(reg) {
+  return { words: reg & 1 ? [reg * 2, (reg - 1) * 2] : [reg * 2], fcsr: false };
+}
+
+const kFunctMov = 0x06;
+const kNoCop1Writes = Object.freeze({ words: [], fcsr: false });
