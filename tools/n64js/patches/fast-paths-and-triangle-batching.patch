diff --git a/src/hle/graphics/display_list_batching.test.js b/src/hle/graphics/display_list_batching.test.js
new file mode 100644
index 0000000..47eaa87
--- /dev/null
+++ b/src/hle/graphics/display_list_batching.test.js
@@ -0,0 +1,102 @@
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test';
+import { executeDisplayList } from './display_list.js';
+import { graphicsOptions } from './graphics_options.js';
+import { GBI1 } from './microcodes/gbi1.js';
+import { GBI2 } from './microcodes/gbi2.js';
+import { NullRenderer } from './null_renderer.js';
+import { RSPState } from './rsp_state.js';
+
+// With graphicsOptions.batchTriangles, triangles from batches separated only
+// by vertex loads, vertex edits and the like are drawn together, and drawn
+// before any other command; the triangles drawn are the same.
+
+function run(Type, commands, { batch, disassemble = false } = {}) {
+  graphicsOptions.batchTriangles = batch;
+  const ram = new DataView(new ArrayBuffer(0x10000));
+  const state = new RSPState();
+  state.reset(ram, 8);
+  const microcode = new Type(state, ram);
+  microcode.renderer = new NullRenderer(state);
+  microcode.warn = () => {};
+  for (let i = 0; i < 32; ++i) {
+    ram.setInt16(0x8000 + i * 16, i * 3);
+    ram.setInt16(0x8000 + i * 16 + 2, -i * 5);
+    ram.setUint32(0x8000 + i * 16 + 12, 0x01020304 * (i + 1));
+  }
+  commands.forEach(([cmd0, cmd1], i) => {
+    ram.setUint32(8 + i * 8, cmd0 >>> 0);
+    ram.setUint32(12 + i * 8, cmd1 >>> 0);
+  });
+  const draws = [];
+  microcode.renderer.flushTris = buffer => {
+    draws.push([...buffer.colours.slice(0, buffer.numTris * 3)]);
+    buffer.reset();
+  };
+  // (a disassembler that accepts and formats anything)
+  const disassembler = disassemble ? new Proxy({}, { get: () => () => '' }) : null;
+  executeDisplayList(state, microcode, { disassembler });
+  return draws;
+}
+
+const kinds = {
+  GBI1: {
+    Type: GBI1,
+    vertex: (n, v0, at) => [(0x04 << 24) | ((n - 1) << 20) | (v0 << 16) | (n * 16), at],
+    tri: (a, b, c) => [0xbf000000, (a * 10 << 16) | (b * 10 << 8) | c * 10],
+    tri2: (a, b, c, d, e, f) => [(0xb1 << 24) | (a * 10 << 16) | (b * 10 << 8) | c * 10, (d * 10 << 16) | (e * 10 << 8) | f * 10],
+    modify: (index, rgba) => [(0xb2 << 24) | 0x100000 | (index * 2), rgba],
+    end: [0xb8000000, 0],
+  },
+  GBI2: {
+    Type: GBI2,
+    vertex: (n, v0, at) => [(0x01 << 24) | (n << 12) | ((v0 + n) << 1), at],
+    tri: (a, b, c) => [(0x05 << 24) | (c << 17) | (b << 9) | (a << 1), 0],
+    tri2: (a, b, c, d, e, f) => [(0x06 << 24) | (f << 17) | (e << 9) | (d << 1), (c << 17) | (b << 9) | (a << 1)],
+    modify: (index, rgba) => [(0x02 << 24) | 0x100000 | (index * 2), rgba],
+    end: [0xdf000000, 0],
+  },
+};
+
+let saved;
+beforeEach(() => { saved = graphicsOptions.batchTriangles; });
+afterEach(() => { graphicsOptions.batchTriangles = saved; });
+
+for (const [name, k] of Object.entries(kinds)) {
+  describe(`${name} batching`, () => {
+    const list = [
+      k.vertex(8, 0, 0x8000),
+      k.tri(0, 1, 2),
+      k.tri2(1, 2, 3, 3, 4, 5),
+      k.modify(2, 0xff0000ff),
+      k.tri(0, 1, 2),
+      k.vertex(8, 0, 0x8080),
+      k.tri(5, 6, 7),
+      [0xfa000000, 0x11223344],   // G_SETPRIMCOLOR: changes how triangles are drawn
+      k.tri(0, 1, 2),
+      [0xe7000000, 0],            // G_RDPPIPESYNC
+      k.tri2(2, 3, 4, 4, 5, 6),
+      k.end,
+    ];
+
+    test('joins batches until a command that could change the drawing, with the same triangles', () => {
+      const single = run(k.Type, list, { batch: false });
+      const batched = run(k.Type, list, { batch: true });
+      expect(single.length).toBe(6);
+      expect(batched.length).toBe(3);
+      expect(batched).toEqual([single.slice(0, 4).flat(), single[4], single[5]]);
+    });
+
+    test('draws what is left at the end of the list, and splits batches that fill the buffer', () => {
+      const tris = Array.from({ length: 600 }, (_, i) => k.tri(i % 6, (i + 1) % 6, (i + 2) % 6));
+      const commands = [k.vertex(8, 0, 0x8000), ...tris.slice(0, 300), k.vertex(8, 0, 0x8080), ...tris.slice(300), k.end];
+      const single = run(k.Type, commands, { batch: false });
+      const batched = run(k.Type, commands, { batch: true });
+      expect(batched.map(d => d.length / 3)).toEqual([512, 88]);
+      expect(batched.flat()).toEqual(single.flat());
+    });
+
+    test('the debugger draws each batch as it comes', () => {
+      expect(run(k.Type, list, { batch: true, disassemble: true })).toEqual(run(k.Type, list, { batch: false, disassemble: true }));
+    });
+  });
+}
