index 0000000..628ebdf
--- /dev/null
+++ b/src/cpu/recompiler_inline_f32.test.js
@@ -0,0 +1,125 @@
+import { beforeAll, expect, test } from 'bun:test';
+import { createHeadlessEmulator } from '../headless/headless_env.js';
+import { CPU1 } from './cpu1.js';
+import { Fragment } from './fragments.js';
+import { FragmentContext, emitTraceStep } from './recompiler.js';
+import * as decode from './decode.js';
+
+// The recompiler's inline single-precision ADD/SUB/MUL/DIV must match the
+// CPU1 helpers exactly: result bits, FCSR, and whether an FPE was raised.
+
+const pc = 0x80001000;
+const fmtS = 0x10, fmtW = 0x14;
+const encode = (fmt, funct, fd, fs, ft) => ((decode.OP_COP1 << 26) | (fmt << 21) | (ft << 16) | (fs << 11) | (fd << 6) | funct) >>> 0;
+
+// name: [format, funct, how the helper is called]
+const ops = {
+  ADD_S: [fmtS, 0x00, (cpu1, d, s, t) => cpu1.ADD_S(d, s, t)],
+  SUB_S: [fmtS, 0x01, (cpu1, d, s, t) => cpu1.SUB_S(d, s, t)],
+  MUL_S: [fmtS, 0x02, (cpu1, d, s, t) => cpu1.MUL_S(d, s, t)],
+  DIV_S: [fmtS, 0x03, (cpu1, d, s, t) => cpu1.DIV_S(d, s, t)],
+  ABS_S: [fmtS, 0x05, (cpu1, d, s) => cpu1.ABS_S(d, s)],
+  MOV_S: [fmtS, 0x06, (cpu1, d, s) => cpu1.MOV_S(d, s)],
+  NEG_S: [fmtS, 0x07, (cpu1, d, s) => cpu1.NEG_S(d, s)],
+  ROUND_W_S: [fmtS, 0x0c, (cpu1, d, s) => cpu1.ConvertSToW(d, s, 0)],
+  TRUNC_W_S: [fmtS, 0x0d, (cpu1, d, s) => cpu1.ConvertSToW(d, s, 1)],
+  CEIL_W_S: [fmtS, 0x0e, (cpu1, d, s) => cpu1.ConvertSToW(d, s, 2)],
+  FLOOR_W_S: [fmtS, 0x0f, (cpu1, d, s) => cpu1.ConvertSToW(d, s, 3)],
+  CVT_W_S: [fmtS, 0x24, (cpu1, d, s) => cpu1.ConvertSToW(d, s, cpu1.roundingMode)],
+  CVT_S_W: [fmtW, 0x20, (cpu1, d, s) => cpu1.CVT_S_W(d, s)],
+};
+for (let cond = 0x30; cond < 0x40; cond++) {
+  ops[`C_${cond.toString(16)}_S`] = [fmtS, cond, (cpu1, d, s, t) => cpu1.handleFloatCompareSingle(cond, s, t)];
+}
+
+beforeAll(async () => {
+  await createHeadlessEmulator({ romBuffer: new ArrayBuffer(0x1000), rominfo: { cic: '6102', tvType: 1, save: 'Eeprom4k' } });
+});
+
+function compile(instruction) {
+  const fragment = new Fragment(pc);
+  fragment.cop1statusKnown = true;
+  fragment.needsDelayCheck = false;
+  fragment.opsCompiled++;
+  const ctx = new FragmentContext();
+  emitTraceStep(fragment, { pc, instruction, postPC: pc + 4, nextPC: pc + 4 }, ctx);
+  ctx.flushDelayedPCUpdate();
+  return fragment.bodyCode;
+}
+
+// A random float's bits, from classes that exercise every path
+function randomBits(rand) {
+  const sign = rand() < 0.5 ? 0x80000000 : 0;
+  const mantissa = Math.floor(rand() * 0x800000);
+  const pick = rand();
+  if (pick < 0.08) return (sign | 0) >>> 0;                          // zero
+  if (pick < 0.12) return (sign | Math.max(1, mantissa)) >>> 0;      // denormal
+  if (pick < 0.15) return (sign | 0x7f800000) >>> 0;                 // infinity
+  if (pick < 0.18) return (0x7f800000 | Math.max(1, mantissa)) >>> 0; // NaN
+  if (pick < 0.24) return (sign | ((126 + Math.floor(rand() * 4)) << 23) | (rand() < 0.5 ? 0 : 0x400000)) >>> 0; // halves
+  if (pick < 0.3) return (sign | ((150 + Math.floor(rand() * 10)) << 23) | mantissa) >>> 0; // near the int limits
+  if (pick < 0.34) return (rand() * 0x100000000) >>> 0;              // any word (for CVT.S.W)
+  let exponent;
+  if (pick < 0.44) exponent = 1 + Math.floor(rand() * 8);            // near underflow
+  else if (pick < 0.54) exponent = 246 + Math.floor(rand() * 8);     // near overflow
+  else exponent = 100 + Math.floor(rand() * 56);                     // ordinary
+  return (sign | (exponent << 23) | mantissa) >>> 0;
+}
+
+function seeded(seed) {
+  return () => {
+    seed = (seed * 1103515245 + 12345) >>> 0;
+    return ((seed >>> 8) & 0xffffff) / 0x1000000;
+  };
+}
+
+let seed = 1;
+for (const [name, [fmt, funct, helper]] of Object.entries(ops)) {
+  test(`inline ${name} matches the helper`, () => {
+    const rand = seeded(seed++);
+    for (let n = 0; n < 3000; n++) {
+      const fullMode = rand() < 0.7;
+      const fd = Math.floor(rand() * 32), fs = Math.floor(rand() * 32), ft = Math.floor(rand() * 32);
+      const code = compile(encode(fmt, funct, fd, fs, ft));
+      if (name !== 'MOV_S') {
+        expect(code).toContain('let fast = false;');
+      }
+      // FCSR: mostly the fast case, sometimes other rounding, enables, flush, flags, condition
+      let fcsr = 0;
+      const mode = rand();
+      if (mode < 0.15) fcsr |= Math.floor(rand() * 4);
+      if (mode > 0.85) fcsr |= Math.floor(rand() * 32) << 7;
+      if (rand() < 0.2) fcsr |= 0x01000000;
+      if (rand() < 0.3) fcsr |= Math.floor(rand() * 32) << 2;
+      if (rand() < 0.2) fcsr |= Math.floor(rand() * 64) << 12;
+      if (rand() < 0.5) fcsr |= 0x00800000;
+      const regs = Array.from({ length: 64 }, () => (rand() * 0x100000000) >>> 0);
+      const sBits = randomBits(rand), tBits = randomBits(rand);
+
+      const run = compiled => {
+        let raised = 0;
+        const c = { pc, delayPC: null, nextPC: 0, stuffToDo: 0, fragmentOps: 0 };
+        const cpu1 = new CPU1({ cpu0: { raiseFPE() { raised++; c.nextPC = 0x80000180; } } });
+        cpu1.reset();
+        cpu1.fullMode = fullMode;
+        cpu1.regU32.set(regs);
+        cpu1.regU32[cpu1.regIdx32_s[fs]] = sBits;
+        cpu1.regU32[cpu1.regIdx32_t[ft]] = tBits;
+        cpu1.control[31] = fcsr;
+        if (compiled) {
+          new Function('c', 'cpu1', 'rsp', code)(c, cpu1, { halted: true, step() {} });
+        } else {
+          helper(cpu1, fd, fs, ft);
+          c.pc = raised ? 0x80000180 : pc + 4;
+        }
+        return { regs: [...cpu1.regU32], fcsr: cpu1.control[31], raised, pc: c.pc };
+      };
+      const want = run(false), got = run(true);
+      if (JSON.stringify(got) !== JSON.stringify(want)) {
+        throw new Error(`${name} f${fd}, f${fs}=${sBits.toString(16)}, f${ft}=${tBits.toString(16)}, fcsr ${fcsr.toString(16)}, fr ${fullMode}: ` +
+          `got fcsr ${got.fcsr.toString(16)} raised ${got.raised} pc ${got.pc.toString(16)}, ` +
+          `want fcsr ${want.fcsr.toString(16)} raised ${want.raised} pc ${want.pc.toString(16)}`);
+      }
+    }
+  }, 60000);
+}
