+#ifdef __EMSCRIPTEN__
+/* frunk.store: the page reads touches, and the mouse, over the canvas
+ * itself and hands them in here as SDL events, so taps, drags and pinches
+ * can be told apart before the game sees them. A drag with two fingers
+ * moves the map (web_scroll); the page's Ctrl and Shift buttons hold those
+ * keys down (web_modifiers). */
+static bool _web_ctrl = false;
+static bool _web_shift = false;
+static Point _web_scroll = {0, 0};
+uint32_t _web_frames = 0; ///< Draw ticks so far, counted by Paint().
+static bool _web_editing = false;
+static SDL_Window *_web_window = nullptr;
+
+extern "C" {
+
+/** A mouse event in the game's pixels: 0 move, 1 button down, 2 button up
+ * (button 1 left, 3 right), 3 wheel (button = steps, + toward the player),
+ * 4 the pointer entered the game, 5 the pointer left it. */
+EMSCRIPTEN_KEEPALIVE void web_mouse(int type, int x, int y, int button)
+{
+	SDL_Event ev = {};
+	switch (type) {
+		case 0:
+			ev.type = SDL_MOUSEMOTION;
+			ev.motion.x = x;
+			ev.motion.y = y;
+			break;
+		case 1:
+		case 2:
+			ev.type = type == 1 ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+			ev.button.button = button;
+			ev.button.x = x;
+			ev.button.y = y;
+			break;
+		case 3:
+			ev.type = SDL_MOUSEWHEEL;
+			ev.wheel.y = -button;
+			ev.wheel.preciseY = static_cast<float>(-button);
+			break;
+		case 4:
+		case 5:
+			ev.type = SDL_WINDOWEVENT;
+			ev.window.event = type == 4 ? SDL_WINDOWEVENT_ENTER : SDL_WINDOWEVENT_LEAVE;
+			break;
+		default: return;
+	}
+	SDL_PushEvent(&ev);
+}
+
+/** The page's room for the game changed size, in the game's pixels. */
+EMSCRIPTEN_KEEPALIVE void web_resize(int w, int h)
+{
+	if (_web_window != nullptr) SDL_SetWindowSize(_web_window, w, h);
+}
+
+/** Moves the main view by this many of the game's pixels. */
+EMSCRIPTEN_KEEPALIVE void web_scroll(int dx, int dy)
+{
+	_web_scroll.x += dx;
+	_web_scroll.y += dy;
+}
+
+EMSCRIPTEN_KEEPALIVE void web_modifiers(int ctrl, int shift)
+{
+	_web_ctrl = ctrl != 0;
+	_web_shift = shift != 0;
+}
+
+/** What the game is doing, for the page: bits 0-1 the game mode (0 the
+ * title screen, 1 a game, 2 the scenario editor, 3 starting up), bit 2 a
+ * modal progress (making a world, saving), bit 3 a text box has the
+ * focus. */
+EMSCRIPTEN_KEEPALIVE int web_state()
+{
+	int mode = _game_mode == GM_MENU ? 0 : _game_mode == GM_NORMAL ? 1 : _game_mode == GM_EDITOR ? 2 : 3;
+	return mode | (HasModalProgress() ? 4 : 0) | (_web_editing ? 8 : 0);
+}
+
+/** Whether a window other than the main view is at this point. */
+EMSCRIPTEN_KEEPALIVE int web_window_at(int x, int y)
+{
+	Window *w = FindWindowFromPt(x, y);
+	return w != nullptr && w->window_class != WC_MAIN_WINDOW;
+}
+
+/** Where the main view is, for checks: 0 its x, 1 its y, 2 its zoom level. */
+EMSCRIPTEN_KEEPALIVE int web_view(int what)
+{
+	Window *w = FindWindowById(WC_MAIN_WINDOW, 0);
+	if (w == nullptr || w->viewport == nullptr) return 0;
+	switch (what) {
+		case 0: return w->viewport->scrollpos_x;
+		case 1: return w->viewport->scrollpos_y;
+		case 2: return to_underlying(w->viewport->zoom);
+		default: return 0;
+	}
+}
+
+/** Runs a console command, such as "saveconfig". */
+EMSCRIPTEN_KEEPALIVE void web_cmd(const char *command)
+{
+	IConsoleCmdExec(command);
+}
+
+/** Frames drawn so far. */
+EMSCRIPTEN_KEEPALIVE uint32_t web_frames()
+{
+	return _web_frames;
+}
+
+/** Saves the game in progress as autosave/exit.sav (as the game does when
+ * it's left with "save on exit"), for the page's Continue. */
+EMSCRIPTEN_KEEPALIVE int web_autosave()
+{
+	if (_game_mode != GM_NORMAL || HasModalProgress()) return 0;
+	DoExitSave();
+	return 1;
+}
+
+}
+#endif /* __EMSCRIPTEN__ */
