+/* [frunk] Mouse units across the whole screen: the video mode's, unless the
+ * game narrowed the range to no wider than the screen's pixels, which
+ * means it counts in pixels. */
+static void web_units(float &ux, float &uy) {
+	ux = mouse.screen_x; uy = mouse.screen_y;
+	if (ux <= 0 || uy <= 0) { ux = mouse.max_x; uy = mouse.max_y; }
+	if (mouse.max_x - mouse.min_x + 1 <= (Bits)CurMode->swidth) ux = CurMode->swidth;
+	if (mouse.max_y - mouse.min_y + 1 <= (Bits)CurMode->sheight) uy = CurMode->sheight;
+}
+
+/* [frunk] Where the game has the pointer, in screen pixels, so the page
+ * follows when the game moves it (Arena does, in its menus) */
+extern "C" EMSCRIPTEN_KEEPALIVE int web_mouse_x(void) {
+	float ux, uy; web_units(ux, uy);
+	return ux > 0 ? (int)(POS_X * CurMode->swidth / ux) : 0;
+}
+extern "C" EMSCRIPTEN_KEEPALIVE int web_mouse_y(void) {
+	float ux, uy; web_units(ux, uy);
+	return uy > 0 ? (int)(POS_Y * CurMode->sheight / uy) : 0;
+}
+#endif
