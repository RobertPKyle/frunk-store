 #ifdef EMSCRIPTEN
+// [frunk] Lets the page run (input, drawing, sound) between slices of
+// emulation. A MessageChannel message, unlike emscripten_sleep()'s timer,
+// isn't held back to 4 ms when timers nest. While the page holds a promise
+// in Module.webHold (it's hidden), emulation waits for it.
+EM_ASYNC_JS(void, em_yield, (void), {
+  await new Promise(resolve => {
+    const c = new MessageChannel();
+    c.port1.onmessage = resolve;
+    c.port2.postMessage(0);
+  });
+  while (Module.webHold) await Module.webHold;
+});
+extern "C" EMSCRIPTEN_KEEPALIVE int web_cycles(void) { return CPU_CycleMax; }
 static int ticksEntry;
 #if defined(EMTERPRETER_SYNC) || defined(EM_ASYNCIFY)
