+// has drawn (and so polled the mouse) a couple of times
+static int web_frame_count = 0;
+extern "C" EMSCRIPTEN_KEEPALIVE int web_frames(void) { return web_frame_count; }
+
+// [frunk] A key from the page (controller, on-screen buttons, the car's
+// keyboard), by SDL scancode, as if typed
+extern "C" EMSCRIPTEN_KEEPALIVE void web_key(int scancode, int down) {
+	SDL_Event e;
+	memset(&e, 0, sizeof(e));
+	e.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+	e.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+	e.key.keysym.scancode = (SDL_Scancode)scancode;
+	e.key.keysym.sym = SDL_GetKeyFromScancode((SDL_Scancode)scancode);
+	if (sdl.window) e.key.windowID = SDL_GetWindowID(sdl.window);
+	SDL_PushEvent(&e);
+}
+#endif
