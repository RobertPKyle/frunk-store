+#ifdef __EMSCRIPTEN__
+// Calls for the page (apps/sopwith/sopwith.js on frunk.store), which turns
+// touch and controllers into these.
+
+// Holds or lets go of one of the game's keys (enum gamekey).
+EMSCRIPTEN_KEEPALIVE void web_key(int key, int down)
+{
+	if (key <= KEY_UNKNOWN || key >= NUM_KEYS) {
+		return;
+	}
+	if (down) {
+		keysdown[key] |= KEYDOWN_TOUCH | KEYDOWN_WAS_PRESSED;
+	} else {
+		keysdown[key] &= ~KEYDOWN_TOUCH;
+	}
+}
+
+// Types one character, as the menus and the name prompt read them
+// (27 is Escape, 13 is Enter, 8 is Backspace).
+EMSCRIPTEN_KEEPALIVE void web_char(int c)
+{
+	SDL_Keysym k = {0};
+	k.sym = c;
+	k.scancode = c == 27 ? SDL_SCANCODE_ESCAPE : SDL_SCANCODE_UNKNOWN;
+	InputBufferPush(k);
+}
+
+// Ctrl+R (restart the level) or Ctrl+Q (end the game).
+EMSCRIPTEN_KEEPALIVE void web_ctrl(int c)
+{
+	web_ctrl_key = c;
+}
+
+// Whether the game is waiting for typed text (the high score name).
+EMSCRIPTEN_KEEPALIVE int web_text_input(void)
+{
+	return SDL_IsTextInputActive();
+}
+#endif
+
 void Vid_StartTextInput(void)
 {
 	SDL_StartTextInput();
