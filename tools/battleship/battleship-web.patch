diff --git a/port/coroutine_emscripten.cpp b/port/coroutine_emscripten.cpp
new file mode 100644
index 0000000..5cd0f7a
--- /dev/null
+++ b/port/coroutine_emscripten.cpp
@@ -0,0 +1,141 @@
+/**
+ * coroutine_emscripten.cpp — Emscripten fiber coroutine implementation.
+ *
+ * WebAssembly has no way to switch native stacks, so each coroutine is an
+ * emscripten_fiber_t: a C stack plus an Asyncify buffer that holds the
+ * unwound WebAssembly call stack while the fiber is suspended. The caller's
+ * context is captured fresh on every resume, which keeps nested resumes
+ * (main -> service thread -> GObj thread) working like the ucontext backend.
+ */
+
+#if defined(__EMSCRIPTEN__)
+
+#include "coroutine.h"
+#include "port_watchdog.h"
+
+#include <emscripten/fiber.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define MIN_STACK_SIZE 32768
+#define CALLER_ASYNCIFY_SIZE (128 * 1024)
+
+struct PortCoroutine {
+	emscripten_fiber_t fiber;
+	emscripten_fiber_t caller;
+	void (*entry)(void *);
+	void *arg;
+	int finished;
+	char *c_stack;
+	char *asyncify_stack;
+	char *caller_asyncify_stack;
+};
+
+static PortCoroutine *sCurrentCoroutine = NULL;
+
+static void fiber_entry(void *p)
+{
+	PortCoroutine *co = (PortCoroutine *)p;
+
+	co->entry(co->arg);
+
+	co->finished = 1;
+	sCurrentCoroutine = NULL;
+
+	/* A fiber's entry must never return; hand control back for good. */
+	emscripten_fiber_swap(&co->fiber, &co->caller);
+	abort();
+}
+
+void port_coroutine_init_main(void)
+{
+}
+
+PortCoroutine *port_coroutine_create(void (*entry)(void *), void *arg,
+                                     size_t stack_size)
+{
+	if (stack_size < MIN_STACK_SIZE) {
+		stack_size = MIN_STACK_SIZE;
+	}
+
+	PortCoroutine *co = (PortCoroutine *)calloc(1, sizeof(PortCoroutine));
+	if (co == NULL) {
+		return NULL;
+	}
+	co->c_stack = (char *)malloc(stack_size);
+	co->asyncify_stack = (char *)malloc(stack_size);
+	co->caller_asyncify_stack = (char *)malloc(CALLER_ASYNCIFY_SIZE);
+	if (co->c_stack == NULL || co->asyncify_stack == NULL || co->caller_asyncify_stack == NULL) {
+		free(co->c_stack);
+		free(co->asyncify_stack);
+		free(co->caller_asyncify_stack);
+		free(co);
+		return NULL;
+	}
+
+	co->entry = entry;
+	co->arg = arg;
+	emscripten_fiber_init(&co->fiber, fiber_entry, co, co->c_stack, stack_size,
+	                      co->asyncify_stack, stack_size);
+	return co;
+}
+
+void port_coroutine_destroy(PortCoroutine *co)
+{
+	if (co == NULL) {
+		return;
+	}
+	if (co == sCurrentCoroutine) {
+		fprintf(stderr, "SSB64: port_coroutine_destroy on current coroutine\n");
+		abort();
+	}
+	free(co->c_stack);
+	free(co->asyncify_stack);
+	free(co->caller_asyncify_stack);
+	free(co);
+}
+
+void port_coroutine_resume(PortCoroutine *co)
+{
+	if (co == NULL || co->finished) {
+		return;
+	}
+
+	PortCoroutine *prev = sCurrentCoroutine;
+
+	sCurrentCoroutine = co;
+	emscripten_fiber_init_from_current_context(&co->caller, co->caller_asyncify_stack,
+	                                           CALLER_ASYNCIFY_SIZE);
+	emscripten_fiber_swap(&co->caller, &co->fiber);
+
+	sCurrentCoroutine = prev;
+}
+
+void port_coroutine_yield(void)
+{
+	PortCoroutine *co = sCurrentCoroutine;
+	if (co == NULL) {
+		fprintf(stderr, "SSB64: port_coroutine_yield called outside coroutine\n");
+		return;
+	}
+
+	port_watchdog_note_yield();
+
+	sCurrentCoroutine = NULL;
+	emscripten_fiber_swap(&co->fiber, &co->caller);
+}
+
+int port_coroutine_is_finished(PortCoroutine *co)
+{
+	if (co == NULL) {
+		return 1;
+	}
+	return co->finished;
+}
+
+int port_coroutine_in_coroutine(void)
+{
+	return sCurrentCoroutine != NULL;
+}
+
+#endif /* __EMSCRIPTEN__ */
