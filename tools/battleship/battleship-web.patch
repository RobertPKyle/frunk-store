+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+// Waits for the next browser frame and says whether a 60 Hz game frame is
+// due. A late frame never runs twice, so a slow computer plays slower
+// instead of falling further behind.
+EM_ASYNC_JS(int, port_web_frame_due, (), {
+	const now = await new Promise(requestAnimationFrame);
+	const step = 1000 / 60;
+	if (Module.nextFrameAt === undefined || now - Module.nextFrameAt > step) {
+		Module.nextFrameAt = now;
+	}
+	if (now + 2 < Module.nextFrameAt) {
+		return 0;
+	}
+	Module.nextFrameAt += step;
+	Module.gameFrames = (Module.gameFrames || 0) + 1;
+	return 1;
+});
+#endif
 #ifndef DISABLE_SCRIPTING
 #include "mods/HookManager.h"
 #include "mods/SymbolResolver.h"
