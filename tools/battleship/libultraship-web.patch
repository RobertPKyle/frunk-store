diff --git a/src/libultraship/libultra/os.cpp b/src/libultraship/libultra/os.cpp
index 39f8d5d..76e1361 100644
--- a/src/libultraship/libultra/os.cpp
+++ b/src/libultraship/libultra/os.cpp
@@ -97,7 +97,17 @@ int32_t osContInit(OSMesgQueue* mq, uint8_t* controllerBits, OSContStatus* statu
 
 int32_t osContStartReadData(OSMesgQueue* mesg) {
     if (mesg != nullptr) {
+#ifdef __EMSCRIPTEN__
+        // Games may define osSendMesg with a void* message, and WebAssembly
+        // passes the OSMesg union by address, so pass a plain pointer. The
+        // pointer is volatile so the compiler can't turn this back into a
+        // union call.
+        int32_t (*volatile sendRaw)(OSMesgQueue*, void*, int32_t) =
+            reinterpret_cast<int32_t (*)(OSMesgQueue*, void*, int32_t)>(osSendMesg);
+        sendRaw(mesg, nullptr, OS_MESG_NOBLOCK);
+#else
         osSendMesg(mesg, OSMesg{}, OS_MESG_NOBLOCK);
+#endif
     }
     return 0;
 }
